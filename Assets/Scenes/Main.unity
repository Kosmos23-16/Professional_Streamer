      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 997a43b767814dd0a7642ec9b78cba41, type: 3}
    m_FontSize: 52
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 106
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "is an engaging 3D idle simulator where you start your streaming career
    from scratch \u2014 with an old laptop, an empty room, and big ambitions. Click
    to go live, attract viewers, earn donations, and gradually build your digital
    empire on the fictional MyTube platform.\r\n\r\nUpgrade your gear, customize
    your room, level up your skills, create memes and videos, land sponsorship deals,
    and compete for the title of the world\u2019s #1 streamer.\r\n\r\nThe game features
    a vibrant low-poly art style, humor, and the authentic vibe of streaming culture.
    Your path to the top starts here!\n\nAt the bottom of the screen you have a red
    button where you can play mini games for which you will receive coins and likes.
    Each game is individual, so everyone will find something for themselves. But
    don't forget about streams, because each game is unavailable 15 minutes after
    the game"
